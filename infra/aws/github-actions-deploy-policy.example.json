{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPush",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload"
      ],
      "Resource": [
        "arn:aws:ecr:ap-northeast-2:<ACCOUNT_ID>:repository/devcompass-jobs",
        "arn:aws:ecr:ap-northeast-2:<ACCOUNT_ID>:repository/devcompass-ecosystem"
      ]
    },
    {
      "Sid": "EcsTaskDefinitions",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassTaskRolesToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "<TASK_EXECUTION_ROLE_ARN>",
        "<TASK_ROLE_ARN>"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "UpdateWorkflowStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "arn:aws:cloudformation:ap-northeast-2:<ACCOUNT_ID>:stack/devcompass-jobs-workflow/*"
    },
    {
      "Sid": "ValidateNetworkParameters",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageStateMachineRolePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/*-devcompass-jobs-step-functions",
        "arn:aws:iam::<ACCOUNT_ID>:role/*-devcompass-jobs-scheduler"
      ]
    },
    {
      "Sid": "DescribeLogGroupForStateMachine",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "UpdateStateMachine",
      "Effect": "Allow",
      "Action": [
        "states:DescribeStateMachine",
        "states:UpdateStateMachine"
      ],
      "Resource": "arn:aws:states:ap-northeast-2:<ACCOUNT_ID>:stateMachine:*-devcompass-jobs"
    },
    {
      "Sid": "PassStateMachineRoleToStepFunctions",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/*-devcompass-jobs-step-functions",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "states.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassSchedulerRoleToScheduler",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/*-devcompass-jobs-scheduler",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DescribeSchedulerDlq",
      "Effect": "Allow",
      "Action": "sqs:GetQueueAttributes",
      "Resource": "arn:aws:sqs:ap-northeast-2:<ACCOUNT_ID>:*-devcompass-jobs-scheduler-dlq"
    },
    {
      "Sid": "ManageDailySchedule",
      "Effect": "Allow",
      "Action": [
        "scheduler:GetSchedule",
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:TagResource"
      ],
      "Resource": "arn:aws:scheduler:ap-northeast-2:<ACCOUNT_ID>:schedule/default/*-devcompass-jobs-daily"
    }
  ]
}
